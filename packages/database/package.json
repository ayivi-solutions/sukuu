{
  "name": "@sukuu/database",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "migrate":  "prisma migrate dev --schema=prisma/schema.prisma",
    "seed":     "ts-node --skip-project prisma/seed.ts",
    "validate": "prisma validate --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs":        "^2.4.3"
  },
  "devDependencies": {
    "prisma":          "^5.14.0",
    "ts-node":         "^10.9.2",
    "typescript":      "^5.4.5",
    "@types/node":     "^20.0.0",
    "@types/bcryptjs": "^2.4.6"
  }
}
