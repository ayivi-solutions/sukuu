// ── SYSTEMX ────────────────────────────────────────────────

/// Global platform configuration key-value store
model SystemSettings {
  id                             String  @id @default(uuid())
  key                            String
  value                          String
  description                    String?
  is_public                      Boolean
  updated_at                     DateTime  @updatedAt
  updated_by                     String

  @@schema("system")
  @@map("system_settings")
}

/// Immutable system event log — append-only audit trail
model SystemLog {
  id                             String  @id @default(uuid())
  event_type                     LogEventType
  entity_type                    String
  entity_id                      String?
  user_id                        String?
  school_id                      String?
  ip_address                     String?
  payload                        String?
  created_at                     DateTime  @default(now())

  @@schema("system")
  @@map("system_log")
}

/// Platform user identity — authentication anchor for all roles
model SystemUser {
  id                             String  @id @default(uuid())
  email                          String
  phone                          String?
  password_hash                  String
  is_active                      Boolean
  is_verified                    Boolean
  last_login_at                  DateTime?
  failed_login_count             Int
  locked_until                   DateTime?
  must_reset_password            Boolean
  status                         String
  row_version                    Int  @default(1)
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt
  archived_at                    DateTime?

  @@schema("system")
  @@map("system_user")
}

/// Named roles — defines available permission sets
model SystemRole {
  id                             String  @id @default(uuid())
  name                           String
  label                          String
  description                    String?
  is_system                      Boolean
  school_id                      String?
  row_version                    Int  @default(1)
  created_at                     DateTime  @default(now())
  archived_at                    DateTime?

  @@schema("system")
  @@map("system_role")
}

/// Granular permission definitions — atomic access units
model SystemPermission {
  id                             String  @id @default(uuid())
  module                         String
  action                         String
  resource                       String
  label                          String
  description                    String?

  @@schema("system")
  @@map("system_permission")
}

/// Many-to-many join: roles ↔ permissions
model SystemRolePermission {
  id                             String  @id @default(uuid())
  role_id                        String
  permission_id                  String
  granted_at                     DateTime
  granted_by                     String?

  @@schema("system")
  @@map("system_role_permission")
}

/// Many-to-many join: users ↔ roles, scoped to a school
model SystemUserRole {
  id                             String  @id @default(uuid())
  user_id                        String
  role_id                        String
  school_id                      String
  assigned_at                    DateTime
  assigned_by                    String?
  expires_at                     DateTime?

  @@schema("system")
  @@map("system_user_role")
}

/// Active user sessions — JWT session tracking
model SystemSession {
  id                             String  @id @default(uuid())
  user_id                        String
  refresh_token_hash             String
  ip_address                     String?
  user_agent                     String?
  device_id                      String?
  is_active                      Boolean
  created_at                     DateTime  @default(now())
  expires_at                     DateTime
  last_activity_at               DateTime
  invalidated_at                 DateTime?

  @@schema("system")
  @@map("system_session")
}

/// Trusted device registry for remember-me functionality
model SystemDevice {
  id                             String  @id @default(uuid())
  user_id                        String
  device_fingerprint             String
  device_name                    String?
  device_type                    String?
  is_trusted                     Boolean
  first_seen_at                  DateTime
  last_seen_at                   DateTime

  @@schema("system")
  @@map("system_device")
}

/// API key management for programmatic access
model SystemApiKey {
  id                             String  @id @default(uuid())
  school_id                      String
  key_hash                       String
  label                          String
