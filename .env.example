# ============================================================
# SUKUU API RUNTIME ENVIRONMENT
# ============================================================
#
# NEVER commit real credentials or secrets.
#
# Production application traffic MUST use the non-owner,
# non-BYPASSRLS sukuu_app_runtime PostgreSQL role.
#
# Administrative postgres credentials belong only in controlled
# migration/deployment tooling and must not be exposed to the
# normal API runtime process.
# ============================================================

DATABASE_URL=postgresql://sukuu_app_runtime.opvjooyxbxqchiwnipww:RUNTIME_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=sukuux

# Prisma schema validation/generation may require DIRECT_URL.
# For the API runtime/build environment, keep it least-privilege.
# Controlled migrations may temporarily override this with the
# administrative connection when executing prisma migrate deploy.
DIRECT_URL=postgresql://sukuu_app_runtime.opvjooyxbxqchiwnipww:RUNTIME_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=sukuux

NODE_ENV=development
PORT=3001

JWT_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret

# Dedicated 32-byte base64 HMAC key for versioned refresh-token digests.
# Generate independently; never reuse JWT_REFRESH_SECRET.
REFRESH_TOKEN_DIGEST_SECRET=replace-with-an-independent-32-byte-base64-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Must exactly match the protected system.system_context_secret
# row with id='rls-v1'. Never regenerate independently.
RLS_CONTEXT_SECRET=replace-with-the-provisioned-stage3b-context-secret

CORS_ORIGINS=http://localhost:3000,https://sukuux.ayivisolutions.com

SCHOOL_ID=SCH-001
